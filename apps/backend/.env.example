# Copy the value of your existing DATABASE_URL (same Supabase project/database).
# Change/add the URL query parameter schema=sales_assistant.
# Example only; retain your own host, username, password and existing pooler options.
SALES_ASSISTANT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=sales_assistant"

# Multi-provider AI
AI_PROVIDER=auto
AI_PROVIDER_FALLBACKS=gemini,openai,anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_REQUEST_TIMEOUT_MS=60000

# Real web search for market discovery
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPER_API_KEY=

# Platform administration and contact enrichment
ADMIN_EMAILS=owner@yourdomain.com
HUNTER_API_KEY=
# Outbound marketing email (required for approved email asset delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sales Assistant <marketing@example.com>
SMTP_REPLY_TO=
PUBLIC_API_URL=https://your-api-domain.example.com
MARKETING_EMAIL_MAX_PER_SEND=100

# Social publishing token vault (generate with: openssl rand -hex 32)
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_PUBLISHER_ENABLED=true
META_GRAPH_VERSION=v23.0
