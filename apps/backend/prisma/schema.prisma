generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentRun {
  id          String    @id
  workspaceId String
  agent       String
  task        String
  status      String    @default("COMPLETED")
  result      String
  createdAt   DateTime  @default(now())
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AnalyticsSnapshot {
  id          String          @id
  workspaceId String
  platform    SocialPlatform?
  metric      String
  value       Float
  capturedAt  DateTime        @default(now())
  Workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Approval {
  id          String         @id
  workspaceId String
  contentId   String
  status      ApprovalStatus @default(PENDING)
  note        String?
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?
  Workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Automation {
  id              String         @id
  workspaceId     String
  name            String
  kind            AutomationKind @default(WORKFLOW)
  target          String
  task            String
  context         String         @default("")
  intervalMinutes Int
  isActive        Boolean        @default(true)
  nextRunAt       DateTime
  lastRunAt       DateTime?
  lastResult      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  Workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([isActive, nextRunAt])
  @@index([workspaceId])
}

model BrandProfile {
  id          String    @id
  workspaceId String    @unique
  voice       String    @default("")
  audience    String    @default("")
  guidelines  String    @default("")
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ContentItem {
  id          String          @id
  workspaceId String
  title       String
  body        String          @default("")
  platform    SocialPlatform?
  status      ContentStatus   @default(DRAFT)
  scheduledAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
  Workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  Publication Publication[]
}

model Organization {
  id        String      @id
  name      String
  createdAt DateTime    @default(now())
  Workspace Workspace[]
}

model Publication {
  id              String            @id
  workspaceId     String
  contentItemId   String
  socialAccountId String?
  status          PublicationStatus @default(QUEUED)
  scheduledAt     DateTime
  attempts        Int               @default(0)
  lastError       String?
  createdAt       DateTime          @default(now())
  ContentItem     ContentItem       @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  SocialAccount   SocialAccount?    @relation(fields: [socialAccountId], references: [id])
  Workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id             String         @id
  workspaceId    String
  platform       SocialPlatform
  accountName    String
  externalId     String?
  encryptedToken String?
  isDevelopment  Boolean        @default(true)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  Publication    Publication[]
  Workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, accountName])
}

model SocialInteraction {
  id          String         @id
  workspaceId String
  platform    SocialPlatform
  author      String
  message     String
  receivedAt  DateTime       @default(now())
  isRead      Boolean        @default(false)
  Workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                String              @id
  name              String
  organizationId    String
  createdAt         DateTime            @default(now())
  AgentRun          AgentRun[]
  AnalyticsSnapshot AnalyticsSnapshot[]
  Approval          Approval[]
  Automation        Automation[]
  BrandProfile      BrandProfile?
  ContentItem       ContentItem[]
  Publication       Publication[]
  SocialAccount     SocialAccount[]
  SocialInteraction SocialInteraction[]
  Organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AutomationKind {
  AGENT
  WORKFLOW
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum PublicationStatus {
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  YOUTUBE
  X
  PINTEREST
  THREADS
}
